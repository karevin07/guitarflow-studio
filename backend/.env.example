# Local development template. Export these variables before starting Django.
# core/settings.py reads os.environ; it does not load .env automatically.

# Django secret key - generate a new one for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-key-change-me-in-production

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins
DJANGO_CORS_ORIGINS=http://localhost:3003,http://localhost:5173
